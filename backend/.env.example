# Required for the Groq Llama brain
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# fast | balanced | accurate  (whisper base.en / small.en / medium.en)
ACCURACY_MODE=fast
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

TTS_VOICE=en-US-AriaNeural
FOLLOWUP_WINDOW_SECONDS=12

# Optional wake-word engines
# PORCUPINE_ACCESS_KEY=
# OPENWAKEWORD_MODEL_PATH=
# OPENWAKEWORD_USE_BUNDLED=1

CORS_ORIGINS=["http://localhost:3000"]
